# Run the container with `docker run -p 3000:3000 -t poppler`.
FROM oven/bun:1.4.4-slim@sha256:1846adf22496bd711036aae8be147e57bdebbaea2e5264e3e0b5af1db187d9a4

LABEL org.opencontainers.image.authors="me@philiplehmann.ch"

ARG POPPLER_VERSION

RUN --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && \
    apt-get install --no-install-recommends --yes poppler-utils=${POPPLER_VERSION}

WORKDIR /app

ENV HOST=0.0.0.0
ENV PORT=3000
ENV POPPLER_PROCESS_ENABLED=false
ENV POPPLER_PROCESS_RETENTION_MS=3600000
ENV POPPLER_PROCESS_MAX_COMPLETED=1000

COPY dist/apps/poppler poppler

# You can remove this install step if you build with `--bundle` option.
# The bundled output will include external dependencies.
RUN bun install --production --cwd poppler

USER 1000:1000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["bun", "-e", "fetch(`http://127.0.0.1:${process.env.PORT}/health/liveness`).then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]

CMD [ "bun", "poppler" ]
